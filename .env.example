# LOCAL DEVELOPMENT — Docker PostgreSQL
# Example only. Do not commit real passwords or tokens.
# Spring Boot does not automatically load this file.

SPRING_PROFILES_ACTIVE=local

# Local Docker PostgreSQL
DATABASE_URL=jdbc:postgresql://localhost:5432/buildat
DATABASE_USERNAME=buildat_local
DATABASE_PASSWORD=REPLACE_LOCALLY

# Supabase Auth — real development project
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_ISSUER=https://PROJECT_REF.supabase.co/auth/v1
SUPABASE_JWKS_URI=https://PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_LOCALLY

# Optional database pool override
DATABASE_POOL_MAX_SIZE=5
